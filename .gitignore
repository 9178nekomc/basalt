# ── Build outputs (derived) ──────────────────────────────
build/
.venv/
native/target/

# Maven build intermediates. The three release jars are force-added
# explicitly with `git add -f target/basalt-2.4.0*.jar`.
target/

# ── Generated documentation ──────────────────────────────
# Built by .github/workflows/docs.yml and published to Pages. Keeping the
# HTML out of git costs nothing (it is regenerated from src/ and tools/ on
# every deploy) and stops 12 MiB of rendered pages from being uploaded on
# every push and stored forever in history.
docs/
report/*.html

# ── Compiled / generated artifacts ───────────────────────
*.class
*.bsl
*.bsld

# ── IDE / OS noise ───────────────────────────────────────
.idea/
*.iml
.DS_Store
Thumbs.db

# ── WorkBuddy project data (not part of the source release) ─
.workbuddy-ai/

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log
